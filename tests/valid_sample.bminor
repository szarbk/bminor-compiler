// Sample valid B-Minor program
count: integer = 0;
greeting: string = "Hello\n";

factorial: function integer (n: integer) = {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

main: function integer () = {
    i: integer = 1;
    /* block comment
       spanning lines */
    while (i <= 5) {
        count = count + factorial(i);
        i++;
    }
    return count;
}